---
import NavDrop from "components/NavDrop";
import Menu from "components/Menu";
import { url } from "lib/utils";

export interface Props {
    darkNavBg?: boolean;
}

export const prerender = true;

let { darkNavBg } = Astro.props;
---

<nav class="rounded-full border mx-auto border-primary-1/50 bg-primary-1/10 backdrop-blur-2xl px-6 md:px-12">
    <div class="flex w-full items-center justify-between py-[0.4rem] md:py-[1.2rem] lg:border-b-secondary-1">
        <div class="flex w-full items-center gap-[2.5rem]">
            <a href="/" class="flex items-center gap-4">
                <img src={url("/images/logoBlueIcon.png")} alt="" class="w-12 md:w-16 object-cover" />
            </a>
            <div class="hidden items-center gap-[0.5rem] lg:flex">
                <NavDrop darkNavBg={darkNavBg} client:load />
            </div>
        </div>

        <div
            class="invisible ml-[-6px] flex items-center justify-end gap-4 transition-all duration-500 ease-in-out md:visible md:mb-0 md:w-1/2">
            <a href="#" class="">
                <div class="invisible flex items-center justify-center rounded-lg md:px-4 md:py-2 md:pr-6">
                    <p class="text-[1.1rem] font-light tracking-wider">Sign In</p>
                </div>
            </a>
            <a href="#contact" class="">
                <div class="flex items-center justify-center rounded-full bg-primary-1 md:px-12 md:py-4">
                    <p class="text-sm font-bold tracking-wider text-white md:text-[1.1rem]">Get Started</p>
                </div>
            </a>
        </div>
        <div class="flex md:hidden">
            <Menu client:only="react" />
        </div>
    </div>
</nav>
