---
import Layout from "../../layouts/Layout.astro";
import TextFormat from "lib/helpers/TextFormat";
---

<Layout title="The Greenvest Africa | About Us">
    <section
        class="container relative mt-24 flex w-full max-w-[1700px] flex-col gap-16 overflow-x-hidden px-container-base pt-4 md:gap-[10rem] md:py-[4.5rem] md:pt-[4.5rem] lg:px-container-lg xl:px-container-xl">
        <div class="relative flex w-full flex-col gap-[1.5rem] md:grid md:grid-cols-[1fr_1fr] md:gap-[2.75rem]">
            <div class="flex flex-grow flex-col justify-center gap-6 2xl:gap-8">
                <h1
                    class="max-w-[40rem] text-left text-[2rem] font-[600] leading-[130%] tracking-[0.02rem] text-secondary-2 transition-all duration-500 ease-in-out md:text-[4.4rem] md:leading-[5rem] md:tracking-[0.0225rem] lg:ml-[-0.2rem]">
                    <TextFormat
                        text={" Transforming Waste, Building Wealth."}
                        keyword={"Waste"}
                        keywordClassName="text-primary-1 transition-all duration-500 ease-in-out"
                    />
                </h1>

                <div class="mb-5 flex gap-4 md:mb-0 md:ml-[-6px]">
                    <a href="/" class="rounded-lg">
                        <img src="/svgs/tools/android.svg" class="h-[3.2rem] w-[7rem] lg:h-[5.5rem] lg:w-[6rem]" />
                    </a>
                    <a href="/" class="rounded-lg">
                        <img src="/svgs/tools/ios.svg" class="h-[3.2rem] w-[7rem] lg:h-[5.5rem] lg:w-[6rem]" />
                    </a>
                </div>
            </div>

            <section>
                <div
                    class="relative flex h-full max-h-[45rem] min-h-[25.375rem] w-full flex-col items-end justify-between rounded-3xl lg:min-h-[30.375rem] 2xl:min-h-[40.375rem]"
                    style={{
                        background: `linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.3)), url('/images/hero-new.png')`,
                        backgroundSize: "cover",
                        backgroundPosition: "center",
                    }}>
                </div>
            </section>
        </div>
        <div class="relative flex w-full flex-col-reverse gap-[1.5rem] md:grid md:grid-cols-[1fr_1fr] md:gap-[2.75rem]">
            <section>
                <div
                    class="relative flex h-full max-h-[45rem] min-h-[25.375rem] w-full flex-col items-end justify-between rounded-3xl lg:min-h-[30.375rem] 2xl:min-h-[40.375rem]"
                    style={{
                        background: `linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.3)), url('/images/about/hero1.jpg')`,
                        backgroundSize: "cover",
                        backgroundPosition: "center",
                    }}>
                </div>
            </section>
            <div class="flex flex-grow flex-col justify-center gap-6 2xl:gap-8">
                <p
                    class="w-fit rounded-full bg-primary-1/5 p-4 px-6 text-lg font-[900] text-primary-1 md:p-4 md:px-8 md:text-2xl">
                    Our Mission
                </p>

                <p class="text-[1.18rem] leading-[2.4rem] tracking-[0.0225rem] text-gray-500">
                    At Greenvest Africa, we are committed to revolutionizing waste management by providing innovative
                    recycling solutions. Our mission is to bridge the gap between environmental sustainability and
                    economic opportunity for individuals and businesses across Nigeria. We understand the challenges of
                    waste disposal and the untapped value in recyclable materials, and we are here to provide a
                    dependable solution that rewards responsible behavior.
                </p>
            </div>
        </div>
        <div class="relative flex w-full flex-col-reverse gap-[1.5rem] md:grid md:grid-cols-[1fr_1fr] md:gap-[2.75rem]">
            <section class="md:order-2">
                <div
                    class="relative flex h-full max-h-[45rem] min-h-[25.375rem] w-full flex-col items-end justify-between rounded-3xl lg:min-h-[30.375rem] 2xl:min-h-[40.375rem]"
                    style={{
                        background: `linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.3)), url('/images/about/hero.jpg')`,
                        backgroundSize: "cover",
                        backgroundPosition: "center",
                    }}>
                </div>
            </section>
            <div class="flex flex-grow flex-col justify-center gap-6 2xl:gap-8">
                <p
                    class="w-fit rounded-full bg-primary-1/5 p-4 px-6 text-lg font-[900] text-primary-1 md:p-4 md:px-8 md:text-2xl">
                    Our Story
                </p>

                <p class="text-[1.18rem] leading-[2.4rem] tracking-[0.0225rem] text-gray-500">
                    Founded by a team of experts passionate about environmental sustainability and technology, Greenvest
                    Africa was born out of a need to address a critical challenge in Nigeria - the waste management
                    crisis and its impact on communities. We saw how recyclable materials were being discarded when they
                    could generate income, and recognized the opportunity to create positive change. Hence, we developed
                    Greenvest Africa, a platform that not only offers financial rewards but also brings transparency,
                    accessibility, and community empowerment to recycling.
                </p>
            </div>
        </div>
        <div class="relative flex w-full flex-col-reverse gap-[1.5rem] md:grid md:grid-cols-[1fr_1fr] md:gap-[2.75rem]">
            <section>
                <div
                    class="relative flex h-full max-h-[45rem] min-h-[25.375rem] w-full flex-col items-end justify-between rounded-3xl lg:min-h-[30.375rem] 2xl:min-h-[40.375rem]"
                    style={{
                        background: `linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.3)), url('/images/modal.png')`,
                        backgroundSize: "cover",
                        backgroundPosition: "center",
                    }}>
                </div>
            </section>
            <div class="flex flex-grow flex-col justify-center gap-6 2xl:gap-8">
                <p
                    class="w-fit rounded-full bg-primary-1/5 p-4 px-6 text-lg font-[900] text-primary-1 md:p-4 md:px-8 md:text-2xl">
                    Our Vision
                </p>

                <p class="text-[1.18rem] leading-[2.4rem] tracking-[0.0225rem] text-gray-500">
                    Our vision is to become an integral part of Nigeria's environmental transformation and economic
                    growth, particularly in underserved communities. We aim to create a world where waste is no longer a
                    problem but a valuable resource. By fostering strong relationships between individuals, businesses,
                    and the environment, we envision a more connected, cleaner, and thriving green economy across
                    Africa.
                </p>
            </div>
        </div>
        <div class="relative flex w-full flex-col-reverse gap-[1.5rem] md:grid md:grid-cols-[1fr_1fr] md:gap-[2.75rem]">
            <section class="md:order-2">
                <div
                    class="relative flex h-full max-h-[45rem] min-h-[25.375rem] w-full flex-col items-end justify-between rounded-3xl lg:min-h-[30.375rem] 2xl:min-h-[40.375rem]"
                    style={{
                        background: `linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.3)), url('/images/needs.png')`,
                        backgroundSize: "cover",
                        backgroundPosition: "center",
                    }}>
                </div>
            </section>
            <div class="flex flex-grow flex-col justify-center gap-6 2xl:gap-8">
                <p
                    class="w-fit rounded-full bg-primary-1/5 p-4 px-6 text-lg font-[900] text-primary-1 md:p-4 md:px-8 md:text-2xl">
                    Our Values
                </p>

                <ul class="list-disc space-y-2 pl-5 text-[1.18rem] leading-[2.4rem] tracking-[0.0225rem] text-gray-500">
                    <li>
                        <strong>Integrity and Transparency:</strong><br /> We believe in honest and open communication,
                        providing clear pricing and instant payments to build trust.
                    </li>
                    <li>
                        <strong>Innovation:</strong><br /> Continuously developing creative solutions like USSD
                        technology to make recycling accessible to everyone.
                    </li>
                    <li>
                        <strong>Community Impact:</strong><br /> Building strong partnerships with individuals,
                        businesses, and communities for environmental protection and shared prosperity.
                    </li>
                    <li>
                        <strong>Commitment to Excellence:</strong><br /> Ensuring the highest standards in all our
                        services, from collection to payment processing.
                    </li>
                    <li>
                        <strong>Empowerment:</strong><br /> Empowering our users by providing them with the tools and
                        rewards they need to make sustainable choices profitable.
                    </li>
                </ul>
            </div>
        </div>
        <div class="relative flex w-full flex-col-reverse gap-[1.5rem] md:grid md:grid-cols-[1fr_1fr] md:gap-[2.75rem]">
            <section>
                <div
                    class="relative flex h-full max-h-[45rem] min-h-[25.375rem] w-full flex-col items-end justify-between rounded-3xl lg:min-h-[30.375rem] 2xl:min-h-[40.375rem]"
                    style={{
                        background: `linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.3)), url('/images/hero-new.png')`,
                        backgroundSize: "cover",
                        backgroundPosition: "center",
                    }}>
                </div>
            </section>
            <div class="flex flex-grow flex-col justify-center gap-6 2xl:gap-8">
                <p
                    class="w-fit rounded-full bg-primary-1/5 p-4 px-6 text-lg font-[900] text-primary-1 md:p-4 md:px-8 md:text-2xl">
                    Our Promise
                </p>

                <p class="text-[1.18rem] leading-[2.4rem] tracking-[0.0225rem] text-gray-500">
                    At Greenvest Africa, we promise to be more than just a recycling platform. We are your partners in
                    sustainability, committed to supporting you at every step of your journey. From convenient drop-off
                    points to instant payments via multiple channels, we are here to ensure that your experience is
                    smooth, rewarding, and contributes to a cleaner Nigeria.
                </p>
            </div>
        </div>
        <div class="flex flex-grow flex-col items-center justify-center gap-6 2xl:gap-8">
            <p
                class="w-fit rounded-full bg-primary-1/5 p-4 px-6 text-lg font-[900] text-primary-1 md:p-4 md:px-8 md:text-2xl">
                Join Us!
            </p>

            <p class="mx-auto max-w-xl text-center text-[1.48rem] leading-[2.4rem] tracking-[0.0225rem] text-gray-500">
                Be a part of the Greenvest Africa family and experience a new era of waste management and environmental
                responsibility. Let's build a greener, wealthier future together.
            </p>
        </div>
    </section>

    <section class="w-full px-container-base py-[2.5rem] lg:px-container-lg xl:px-container-xl"></section>
</Layout>
