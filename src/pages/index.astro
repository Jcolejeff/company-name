         <section
            class="w-full py-[3rem] pb-20 md:pt-[6rem] md:pb-[7.25rem] md:py-[5rem] container px-container-base lg:px-container-lg xl:px-container-xl relative max-w-[1700px]"
         >
            <div class="w-full flex flex-col justify-center gap-[2.5rem] md:gap-[2.75rem] relative">
               <div class="gap-6 flex justify-center items-center 2xl:gap-8 flex-col">
                  <Fade bottom client:load>
                     <h2
                        class="font-[500] mt-4 md:mt-10 text-center text-[1.18rem] md:text-[1.3rem] xxl:text-[1.3rem] leading-[2.2rem] md:leading-[2rem] max-w-[38.875rem] xxl:max-w-[45.875rem]"
                     >
                        These businesses already use Greenpact Africa
                     </h2>
                  </Fade>

                  <div
                     class="flex mx-auto items-center gap-4 transition-all duration-500 ease-in-out mb-5"
                  >
                     <LogoMarquee images={images} client:only />
                  </div>
               </div>
            </div>
         </section>
      </section> -->
    </section>

    <section class="w-full scroll-mt-[-20rem] bg-primary-1" id="features">
        <section
            class="container relative w-full max-w-[1700px] overflow-x-hidden px-container-base py-[3rem] text-white md:pb-[4rem] lg:px-container-lg lg:py-[3rem] lg:pb-[6rem] xl:px-container-xl xxl:py-[9rem]">
            <Features client:only />
        </section>
    </section>
    <section class="w-full scroll-mt-28 bg-primary-1/10" id="download">
        <!-- info grid icon cards sections -->
        <section
            class="container relative grid w-full gap-[2rem] max-w-[1700px] md:gap-[5rem] rounded-lg px-container-base py-[3rem] pb-20 md:grid-cols-[1fr_1fr] md:py-[5rem] md:pb-[7.25rem] md:pt-[6rem] lg:px-container-lg xl:px-container-xl">
            <div class="flex w-full flex-col">
                <h4
                    class="mb-[1rem] text-[1.3rem] font-[700] tracking-[0.0125rem] text-secondary-2 lg:text-[1.8rem] lg:leading-[2.5rem] xxl:max-w-[70%] md:mb-[0.5rem]">
                    <TextFormat
                        text={"Turn everyday waste into steady income while building a cleaner Nigeria."}
                        keyword={"cleaner Nigeria."}
                        keywordClassName="text-primary-1 transition-all duration-500 ease-in-out"
                    />
                </h4>

                <img
                    src={url("/images/new/IMG_96955.PNG")}
                    alt=""
                    class="w-full rounded-md md:max-h-[77%] md:object-cover"
                />
                <a
                    href="#"
                    class="mt-10 flex w-6/12 cursor-pointer items-center justify-center rounded-md bg-primary-1 px-4 py-4 text-white shadow-1 transition-opacity duration-300 ease-in-out hover:opacity-90 active:opacity-100 md:hidden md:w-fit">
                    <span class="font-[500] leading-[1.5rem] tracking-[0.02875rem] text-white">Sign up for free</span>
                </a>
            </div>
            <InfoGrid client:only />
        </section>
    </section>
    <section class="w-full bg-primary-1/10">
        <section
            class="container relative w-full max-w-[1700px] px-container-base py-[3rem] md:pt-[6rem] lg:px-container-lg xl:px-container-xl">
            <div class="flex flex-col items-center justify-center gap-6 2xl:gap-8">
                <h1
                    class="max-w-[80rem] text-center text-[1.6rem] font-[700] leading-[130%] tracking-[0.02rem] transition-all duration-500 ease-in-out md:leading-[5rem] md:tracking-[0.0225rem] lg:ml-[-0.2rem] lg:text-[2.6rem] xxl:text-[4rem]">
                    <TextFormat
                        text={`Greenpact Africa makes recycling profitable for everyone in Nigeria.`}
                        keyword={"Greenpact Africa"}
                        keywordClassName="text-primary-1 transition-all duration-500 ease-in-out"
                    />
                </h1>

                <div class="mb-5 flex flex-col items-center gap-4 transition-all duration-500 ease-in-out md:flex-row">
                    <p class="text-center text-base font-bold text-primary-1 md:text-xl xl:text-2xl">
                        Turn your plastics and paper into instant cash or points - accessible via app or USSD, even
                        without internet.
                    </p>
                </div>
            </div>
        </section>
    </section>

    <!-- test animaions -->
    <section class="w-full scroll-mt-28 bg-primary-1" id="download">
        <section
            class="container relative w-full max-w-[1700px] overflow-x-hidden px-container-base py-[4rem] text-white md:py-[10rem] lg:px-container-lg xl:px-container-xl">
            <InfoAboutCompany client:only />
        </section>
    </section>
    <section class="w-full scroll-mt-28 bg-primary-1" id="download">
        <section
            class="container relative w-full max-w-[1700px] overflow-x-hidden px-container-base py-[4rem] text-white md:pt-[0rem] md:pb-[6rem] lg:px-container-lg xl:px-container-xl">
            <HowToSections client:only />
        </section>
    </section>

    <section class="w-full scroll-mt-28 bg-primary-1" id="download">
        <section
            class="container relative w-full max-w-[1700px] overflow-x-hidden px-container-base py-[4rem] md:py-[10rem] lg:px-container-lg xl:px-container-xl">
            <div class="flex w-full flex-col items-center gap-10">
                <div class="">
                    <h2
                        class="max-w-[90rem] text-center text-[2rem] font-[600] leading-[130%] tracking-[0.02rem] text-white transition-all duration-500 ease-in-out md:text-[2.6rem] md:tracking-[0.0225rem] lg:text-[3.4rem] xxl:text-[4rem] xxl:leading-[5rem]">
                        <TextFormat
                            text={`Turn your waste into wealth while building a cleaner Nigeria`}
                            keyword={"wealth"}
                            keywordClassName="text-secondary-1 transition-all duration-500 ease-in-out"
                        />
                    </h2>
                </div>

                <div class="flex items-center gap-4 transition-all duration-500 ease-in-out md:w-1/2 md:justify-center">
                    <a href="#" class="">
                        <div class="flex items-center justify-center rounded-lg bg-white px-4 py-3 md:px-6 md:py-4">
                            <p class="text-sm font-bold tracking-wider text-primary-1 md:text-lg">
                                Get started with Greenpact Africa
                            </p>
                        </div>
                    </a>
                </div>
            </div>
        </section>
    </section>
    <section class="w-full bg-primary-1/10">
        <section
            id="contact"
            class="container relative w-full max-w-[1700px] scroll-mt-[1rem] rounded-lg px-container-base py-[3rem] pb-20 md:py-[10rem] lg:px-container-lg xl:px-container-xl">
            <GetStarted client:only />
        </section>
    </section>
</Layout>
